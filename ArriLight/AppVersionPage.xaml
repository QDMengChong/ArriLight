<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.AppVersionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArriLight"
    x:DataType="local:AppVersionPage"
    Title="应用版本"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,26" Spacing="18">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                <Border
                    HeightRequest="78"
                    WidthRequest="78"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24">
                    <Image Margin="20" Source="device_light_white.svg" />
                </Border>
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    Text="ArriLight"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Label
                    FontSize="13"
                    Text="{Binding VersionText}"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource MenuCardStyle}">
                <VerticalStackLayout Spacing="13">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="18"
                        Text="本次更新"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                    <Label Style="{StaticResource ReleaseNoteStyle}" Text="• 全新的设备管理首页与底部导航" />
                    <Label Style="{StaticResource ReleaseNoteStyle}" Text="• 新增消息中心、版本信息与关于我们" />
                    <Label Style="{StaticResource ReleaseNoteStyle}" Text="• 支持跟随系统、浅色和深色主题" />
                    <Label Style="{StaticResource ReleaseNoteStyle}" Text="• 优化 Android 端界面表现与交互体验" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
