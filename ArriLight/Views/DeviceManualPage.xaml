<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.DeviceManualPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    Title="{x:Static strings:AppResources.Manual_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">
    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,36" Spacing="16">
            <Border Style="{StaticResource MenuCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label FontFamily="OpenSansSemibold" FontSize="22" Text="{x:Static strings:AppResources.Manual_Heading}" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                    <Label FontSize="14" LineHeight="1.45" Text="{x:Static strings:AppResources.Manual_Content}" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                </VerticalStackLayout>
            </Border>
            <Label FontSize="12" HorizontalTextAlignment="Center" Text="{x:Static strings:AppResources.Manual_Placeholder}" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>