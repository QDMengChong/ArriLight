<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ArriLight.DeviceGroupMembersPage" x:Name="MembersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArriLight.ViewModels" xmlns:local="clr-namespace:ArriLight"
    xmlns:controls="clr-namespace:ArriLight.Controls"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    x:DataType="vm:DeviceGroupMembersPageViewModel" Title="{x:Static strings:AppResources.Group_Manage}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding MoreCommand}" IconImageSource="profile_settings.svg"
            Order="Primary" Priority="2" Text="{x:Static strings:AppResources.Common_More}" />
    </ContentPage.ToolbarItems>
    <Grid Padding="20" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <VerticalStackLayout Spacing="10">
            <Label Text="{Binding GroupName}" FontSize="24" Style="{StaticResource MenuTitleStyle}" />
            <Label Text="{x:Static strings:AppResources.Group_MembersHint}" FontSize="12"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light=#B53440, Dark=#FF8990}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Members}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppResources.Group_NoMembers}" HorizontalTextAlignment="Center" Padding="20"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceGroupMemberItem">
                    <Border Margin="0,0,0,12" Padding="0" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkCardBackground}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}">
                        <Border.Shadow>
                            <Shadow Brush="#120B2A5B" Offset="0,4" Opacity="0.18" Radius="12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="16" ColumnDefinitions="64,*" ColumnSpacing="12" MinimumHeightRequest="96">
                                <Border HeightRequest="64" WidthRequest="64" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource DeviceIconBackground}, Dark={StaticResource DarkIconBackground}}">
                                    <Image Margin="16" Source="{Binding Device.ProtocolIconSource}"
                                        SemanticProperties.Description="{x:Static strings:AppResources.Device_DefaultName}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding Device.Name}" FontFamily="OpenSansSemibold" FontSize="17" LineBreakMode="TailTruncation"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Device.IsOnline}" Value="False">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Border Grid.Column="1" Padding="6,2" BackgroundColor="{StaticResource Primary}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 6" VerticalOptions="Center">
                                            <Label Text="{Binding Device.ProtocolLabel}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="White" />
                                        </Border>
                                    </Grid>
                                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                                        <HorizontalStackLayout Margin="0,0,7,0" Spacing="7">
                                            <controls:StatusIndicator HeightRequest="7" WidthRequest="7"
                                                IsBlinking="{Binding Device.IsStatusBlinking}"
                                                IsAnimationEnabled="{Binding AreStatusAnimationsEnabled, Source={x:Reference MembersPage}, x:DataType=local:DeviceGroupMembersPage}"
                                                Fill="{Binding Device.StatusColor, Converter={StaticResource PresentationColorConverter}}" />
                                            <Label Text="{Binding Device.Status}" FontSize="13" VerticalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        </HorizontalStackLayout>
                                        <Grid Margin="0,0,7,0" ColumnDefinitions="35,3" HeightRequest="18" WidthRequest="38"
                                            IsVisible="{Binding Device.IsBatteryVisible}" VerticalOptions="Center">
                                            <BoxView Grid.Column="1" HeightRequest="8" VerticalOptions="Center"
                                                Color="{AppThemeBinding Light=#9297A1, Dark=#A9B2C3}" />
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 3"
                                                BackgroundColor="{AppThemeBinding Light=#60656F, Dark=#687489}">
                                                <Label Text="{Binding Device.BatteryLevelText}" FontFamily="OpenSansSemibold" FontSize="9"
                                                    HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="White" />
                                            </Border>
                                        </Grid>
                                        <Image HeightRequest="15" WidthRequest="15" IsVisible="{Binding Device.IsLocked}" Source="device_locked.svg"
                                            VerticalOptions="Center" SemanticProperties.Description="{x:Static strings:AppResources.Device_Locked}" />
                                    </FlexLayout>
                                    <Label Text="{Binding Reference}" IsVisible="{Binding IsReference}" FontSize="12"
                                        TextColor="{AppThemeBinding Light=#2563C4, Dark=#9CC4FF}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                            <Grid Padding="12" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                <Button Text="{x:Static strings:AppResources.Group_MoveUp}" Padding="4" FontSize="12" MinimumHeightRequest="44" IsEnabled="{Binding CanMoveUp}"
                                    Command="{Binding ViewModel.MoveUpCommand, Source={x:Reference MembersPage}, x:DataType=local:DeviceGroupMembersPage}" CommandParameter="{Binding .}" />
                                <Button Grid.Column="1" Text="{x:Static strings:AppResources.Group_MoveDown}" Padding="4" FontSize="12" MinimumHeightRequest="44" IsEnabled="{Binding CanMoveDown}"
                                    Command="{Binding ViewModel.MoveDownCommand, Source={x:Reference MembersPage}, x:DataType=local:DeviceGroupMembersPage}" CommandParameter="{Binding .}" />
                                <Button Grid.Column="2" Text="{x:Static strings:AppResources.Group_ControlMember}" Padding="4" FontSize="12" MinimumHeightRequest="44"
                                    Command="{Binding ViewModel.ControlMemberCommand, Source={x:Reference MembersPage}, x:DataType=local:DeviceGroupMembersPage}" CommandParameter="{Binding .}" />
                                <Button Grid.Column="3" Text="{x:Static strings:AppResources.Group_RemoveMember}" Padding="4" FontSize="12" MinimumHeightRequest="44"
                                    Command="{Binding ViewModel.RemoveCommand, Source={x:Reference MembersPage}, x:DataType=local:DeviceGroupMembersPage}" CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="{x:Static strings:AppResources.Group_AddMember}" Command="{Binding AddCommand}" />
            <Button Grid.Column="1" Text="{x:Static strings:AppResources.Group_OpenControl}" Command="{Binding OpenControlCommand}" />
        </Grid>
    </Grid>
</ContentPage>
