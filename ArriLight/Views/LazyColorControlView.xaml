<?xml version="1.0" encoding="utf-8" ?>
<local:TimedLazyContentView
    x:Class="ArriLight.LazyColorControlView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArriLight"
    xmlns:controls="clr-namespace:ArriLight.Controls">
    <VerticalStackLayout Spacing="14">
        <controls:ColorTemperaturePicker
            x:Name="ColorPickerElement"
            HeightRequest="260"
            HorizontalOptions="Center"
            SelectionChanged="OnColorPickerSelectionChanged"
            WidthRequest="260" />
    </VerticalStackLayout>
</local:TimedLazyContentView>
