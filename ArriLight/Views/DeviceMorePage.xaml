<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.DeviceMorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArriLight.ViewModels"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    xmlns:local="clr-namespace:ArriLight"
    x:DataType="vm:DeviceMorePageViewModel"
    Title="{x:Static strings:AppResources.Device_Information}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,20,20,28" Spacing="16">
                <Border Style="{StaticResource MenuCardStyle}">
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="16">
                        <Border
                            HeightRequest="64"
                            WidthRequest="64"
                            BackgroundColor="{AppThemeBinding Light={StaticResource DeviceIconBackground}, Dark={StaticResource DarkIconBackground}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                            <Image Margin="16" Source="device_light.svg" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                Text="{Binding DeviceName}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                            <Label
                                FontSize="13"
                                Text="{Binding AddedAtText}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MenuCardStyle}" IsVisible="{Binding IsLocalModeSupported}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                            <Switch
                                IsEnabled="{Binding CanSetLocalMode}"
                                IsToggled="{Binding IsAlwaysOnMode, Mode=TwoWay}"
                                SemanticProperties.Description="{Binding LocalModeLabel}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource MenuTitleStyle}"
                                Text="{Binding LocalModeLabel}"
                                VerticalTextAlignment="Center" />
                            <Border
                                Grid.Column="2"
                                Padding="10,0"
                                IsEnabled="{Binding CanEditLocalModeSeconds}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding CanEditLocalModeSeconds}" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry
                                        FontSize="14"
                                        HorizontalTextAlignment="Center"
                                        Keyboard="Numeric"
                                        MaxLength="7"
                                        SemanticProperties.Description="{x:Static strings:AppResources.DeviceMode_Seconds}"
                                        Text="{Binding LocalModeSecondsText, Mode=TwoWay}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                        VerticalTextAlignment="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="s"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                        VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Style="{StaticResource MenuDescriptionStyle}" Text="{Binding LocalModeNotice}" VerticalTextAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding SetLocalModeCommand}"
                                HorizontalOptions="End"
                                IsEnabled="{Binding CanSetLocalMode}"
                                MinimumWidthRequest="84"
                                Text="{x:Static strings:AppResources.DeviceMode_Set}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MenuCardStyle}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16" ColumnDefinitions="*,Auto" MinimumHeightRequest="58">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RenameCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Device_Name}" VerticalTextAlignment="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Label
                                    FontSize="14"
                                    Text="{Binding DeviceName}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                    VerticalTextAlignment="Center" />
                                <Image Style="{StaticResource MenuChevronStyle}" />
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Margin="16,0" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                        <Grid Padding="16" ColumnDefinitions="*,Auto" MinimumHeightRequest="58">
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Device_AddedAt}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" FontSize="14" Text="{Binding AddedAtText}" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalTextAlignment="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Margin="16,0" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                        <Grid Padding="16" ColumnDefinitions="*,Auto" MinimumHeightRequest="58">
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Device_Id}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" FontSize="13" Text="{Binding DeviceId}" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalTextAlignment="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource MenuCardStyle}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16" ColumnDefinitions="*,Auto" MinimumHeightRequest="58">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ManualCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Manual_Title}" VerticalTextAlignment="Center" />
                            <Image Grid.Column="1" Style="{StaticResource MenuChevronStyle}" />
                        </Grid>
                        <BoxView HeightRequest="1" Margin="16,0" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                        <Grid Padding="16" ColumnDefinitions="*,Auto" MinimumHeightRequest="58">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FirmwareCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Firmware_Title}" VerticalTextAlignment="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Label FontSize="14" Text="{Binding FirmwareVersion}" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalTextAlignment="Center" />
                                <Image Style="{StaticResource MenuChevronStyle}" />
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Margin="16,0" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                        <Grid Padding="16" ColumnDefinitions="*,Auto" MinimumHeightRequest="58">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShareCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Share_Title}" VerticalTextAlignment="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Label FontSize="13" Text="{x:Static strings:AppResources.Share_QrCode}" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalTextAlignment="Center" />
                                <Image Style="{StaticResource MenuChevronStyle}" />
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Margin="16,0" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                        <Grid Padding="16" ColumnDefinitions="*,Auto" MinimumHeightRequest="58">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Device_Pin}" />
                                <Label Style="{StaticResource MenuDescriptionStyle}" Text="{x:Static strings:AppResources.Device_PinDescription}" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="PinnedSwitch"
                                Grid.Column="1"
                                IsToggled="{Binding IsPinned}"
                                Toggled="OnPinnedToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border
            Grid.Row="1"
            Padding="20,12"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkCardBackground}}"
            Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}"
            StrokeThickness="1">
            <Button
                BackgroundColor="Transparent"
                BorderColor="#E65B65"
                BorderWidth="1"
                Command="{Binding UnbindCommand}"
                CornerRadius="24"
                HeightRequest="50"
                Text="{x:Static strings:AppResources.Device_Unbind}"
                TextColor="#E65B65" />
        </Border>
    </Grid>
</ContentPage>
