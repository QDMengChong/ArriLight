<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.MainPage"
    x:Name="HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    xmlns:local="clr-namespace:ArriLight"
    xmlns:vm="clr-namespace:ArriLight.ViewModels"
    x:DataType="vm:MainPageViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            Padding="24,28,24,32"
            StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="1,1">
                    <GradientStop Offset="0" Color="{StaticResource Primary}" />
                    <GradientStop Offset="1" Color="{StaticResource PrimaryLight}" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="24">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="28"
                            Text="{x:Static strings:AppResources.Tab_Devices}"
                            TextColor="White" />
                        <Label
                            FontSize="13"
                            Opacity="0.78"
                            Text="{x:Static strings:AppResources.Home_Description}"
                            TextColor="White" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        HeightRequest="48"
                        WidthRequest="48"
                        BackgroundColor="#24FFFFFF"
                        Stroke="#32FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1">
                        <ImageButton
                            Padding="13"
                            BackgroundColor="Transparent"
                            Command="{Binding ScanQrCodeCommand}"
                            Source="action_scan.svg"
                            SemanticProperties.Description="{x:Static strings:AppResources.Qr_ScanDescription}" />
                    </Border>

                    <Border
                        Grid.Column="2"
                        HeightRequest="48"
                        WidthRequest="48"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <ImageButton
                            Padding="13"
                            BackgroundColor="Transparent"
                            Command="{Binding AddDeviceCommand}"
                            Source="action_add.svg"
                            SemanticProperties.Description="{x:Static strings:AppResources.Device_Add}" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8">
                        <Ellipse
                            HeightRequest="8"
                            WidthRequest="8"
                            Fill="{StaticResource Success}" />
                        <Label
                            FontSize="13"
                            Text="{x:Static strings:AppResources.Home_ServiceReady}"
                            TextColor="#DFFFFFFF"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Border
                        Grid.Column="1"
                        Padding="10,5"
                        BackgroundColor="#1FFFFFFF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20">
                        <Label
                            FontSize="12"
                            Text="{Binding DeviceCountText}"
                            TextColor="White" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="20,24,20,12"
            RowDefinitions="Auto,*"
            RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="20"
                    Text="{x:Static strings:AppResources.Home_MyDevices}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Label
                    Grid.Column="1"
                    FontSize="13"
                    Text="{x:Static strings:AppResources.Home_TapToControl}"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                    VerticalTextAlignment="Center" />
            </Grid>

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Devices}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="24,72"
                        HorizontalOptions="Center"
                        Spacing="12">
                        <Image
                            HeightRequest="56"
                            Opacity="0.45"
                            Source="empty_devices.svg"
                            WidthRequest="56" />
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="17"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static strings:AppResources.Home_Empty}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                        <Label
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static strings:AppResources.Home_AddFirstHint}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <!-- Keep page commands available while refreshed cards detach from the visual tree. -->
                    <DataTemplate x:DataType="vm:LightDeviceItem">
                        <Border
                            Margin="0,0,0,12"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkCardBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="1">
                            <Border.Shadow>
                                <Shadow
                                    Brush="#120B2A5B"
                                    Offset="0,4"
                                    Opacity="0.18"
                                    Radius="12" />
                            </Border.Shadow>

                            <!-- Separate sibling hit regions keep the power button
                                 outside every navigation gesture, even when disabled. -->
                            <Grid ColumnDefinitions="*,56,60" MinimumHeightRequest="96">
                                <Grid Padding="16,16,0,16" ColumnDefinitions="64,*" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewModel.OpenControlCommand, Source={x:Reference HomePage}, x:DataType=local:MainPage}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                <Border
                                    InputTransparent="True"
                                    HeightRequest="64"
                                    WidthRequest="64"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource DeviceIconBackground}, Dark={StaticResource DarkIconBackground}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                    <Image
                                        Margin="16"
                                        Source="device_light.svg"
                                        SemanticProperties.Description="{x:Static strings:AppResources.Device_DefaultName}" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    InputTransparent="True"
                                    Spacing="6"
                                    VerticalOptions="Center">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="17"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Name}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                    <HorizontalStackLayout Spacing="7">
                                        <Ellipse
                                            HeightRequest="7"
                                            WidthRequest="7"
                                            Fill="{Binding StatusColor, Converter={StaticResource PresentationColorConverter}}" />
                                        <Label
                                            FontSize="13"
                                            Text="{Binding Status}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                            VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="6,44,6" RowDefinitions="*,44,*">
                                    <Grid Grid.Row="0" Grid.ColumnSpan="3">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewModel.OpenControlCommand, Source={x:Reference HomePage}, x:DataType=local:MainPage}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.ColumnSpan="3">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewModel.OpenControlCommand, Source={x:Reference HomePage}, x:DataType=local:MainPage}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="0">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewModel.OpenControlCommand, Source={x:Reference HomePage}, x:DataType=local:MainPage}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="2">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewModel.OpenControlCommand, Source={x:Reference HomePage}, x:DataType=local:MainPage}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HeightRequest="44"
                                    WidthRequest="44"
                                    BackgroundColor="{Binding PowerBackgroundColor, Converter={StaticResource PresentationColorConverter}}"
                                    Stroke="{Binding PowerBorderColor, Converter={StaticResource PresentationColorConverter}}"
                                    StrokeShape="RoundRectangle 22"
                                    StrokeThickness="1"
                                    VerticalOptions="Center">
                                    <ImageButton
                                        Padding="9"
                                        BackgroundColor="Transparent"
                                        Command="{Binding ViewModel.TogglePowerCommand, Source={x:Reference HomePage}, x:DataType=local:MainPage}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Opacity="{Binding PowerOpacity}"
                                        Source="{Binding PowerIcon}"
                                        SemanticProperties.Description="{x:Static strings:AppResources.Home_QuickPowerDescription}" />
                                </Border>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewModel.OpenControlCommand, Source={x:Reference HomePage}, x:DataType=local:MainPage}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                <Image
                                    InputTransparent="True"
                                    Margin="13"
                                    HeightRequest="18"
                                    HorizontalOptions="Center"
                                    Opacity="0.55"
                                    Source="chevron_right.svg"
                                    VerticalOptions="Center"
                                    WidthRequest="18"
                                    SemanticProperties.Description="{x:Static strings:AppResources.Home_ControlDescription}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
