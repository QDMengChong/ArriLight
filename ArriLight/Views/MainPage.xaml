<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArriLight"
    x:DataType="local:MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            Padding="24,28,24,32"
            StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="1,1">
                    <GradientStop Offset="0" Color="{StaticResource Primary}" />
                    <GradientStop Offset="1" Color="{StaticResource PrimaryLight}" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="24">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="28"
                            Text="设备"
                            TextColor="White" />
                        <Label
                            FontSize="13"
                            Opacity="0.78"
                            Text="管理你的灯光设备"
                            TextColor="White" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        HeightRequest="48"
                        WidthRequest="48"
                        BackgroundColor="#24FFFFFF"
                        Stroke="#32FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1">
                        <ImageButton
                            Padding="13"
                            BackgroundColor="Transparent"
                            Clicked="OnScanQrCodeClicked"
                            Source="action_scan.svg"
                            SemanticProperties.Description="扫描二维码" />
                    </Border>

                    <Border
                        Grid.Column="2"
                        HeightRequest="48"
                        WidthRequest="48"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <ImageButton
                            Padding="13"
                            BackgroundColor="Transparent"
                            Clicked="OnAddDeviceClicked"
                            Source="action_add.svg"
                            SemanticProperties.Description="添加设备" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8">
                        <Ellipse
                            HeightRequest="8"
                            WidthRequest="8"
                            Fill="{StaticResource Success}" />
                        <Label
                            FontSize="13"
                            Text="蓝牙设备服务已就绪"
                            TextColor="#DFFFFFFF"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Border
                        Grid.Column="1"
                        Padding="10,5"
                        BackgroundColor="#1FFFFFFF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20">
                        <Label
                            FontSize="12"
                            Text="{Binding DeviceCountText}"
                            TextColor="White" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="20,24,20,12"
            RowDefinitions="Auto,*"
            RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="20"
                    Text="我的设备"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Label
                    Grid.Column="1"
                    FontSize="13"
                    Text="点击设备进行控制"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                    VerticalTextAlignment="Center" />
            </Grid>

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Devices}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="24,72"
                        HorizontalOptions="Center"
                        Spacing="12">
                        <Image
                            HeightRequest="56"
                            Opacity="0.45"
                            Source="empty_devices.svg"
                            WidthRequest="56" />
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="17"
                            HorizontalTextAlignment="Center"
                            Text="还没有添加设备"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                        <Label
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            Text="点击右上角的 + 添加你的第一盏灯"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:LightDeviceItem">
                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkCardBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="1">
                            <Border.Shadow>
                                <Shadow
                                    Brush="#120B2A5B"
                                    Offset="0,4"
                                    Opacity="0.18"
                                    Radius="12" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="64,*,Auto,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="64"
                                    WidthRequest="64"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource DeviceIconBackground}, Dark={StaticResource DarkIconBackground}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                    <Image
                                        Margin="16"
                                        Source="device_light.svg"
                                        SemanticProperties.Description="灯光设备" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="6"
                                    VerticalOptions="Center">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="17"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Name}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                    <HorizontalStackLayout Spacing="7">
                                        <Ellipse
                                            HeightRequest="7"
                                            WidthRequest="7"
                                            Fill="{Binding StatusColor}" />
                                        <Label
                                            FontSize="13"
                                            Text="{Binding Status}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                            VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="2"
                                    HeightRequest="44"
                                    WidthRequest="44"
                                    BackgroundColor="{Binding PowerBackgroundColor}"
                                    Stroke="{Binding PowerBorderColor}"
                                    StrokeShape="RoundRectangle 22"
                                    StrokeThickness="1"
                                    VerticalOptions="Center">
                                    <ImageButton
                                        Padding="9"
                                        BackgroundColor="Transparent"
                                        Clicked="OnDevicePowerClicked"
                                        IsEnabled="{Binding IsEnabled}"
                                        Opacity="{Binding PowerOpacity}"
                                        Source="{Binding PowerIcon}"
                                        SemanticProperties.Description="快速开关灯光" />
                                </Border>

                                <ImageButton
                                    Grid.Column="3"
                                    Padding="13"
                                    BackgroundColor="Transparent"
                                    Clicked="OnDeviceManageClicked"
                                    HeightRequest="44"
                                    Opacity="0.55"
                                    Source="chevron_right.svg"
                                    VerticalOptions="Center"
                                    WidthRequest="44"
                                    SemanticProperties.Description="进入设备管理" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
