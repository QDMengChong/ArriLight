<?xml version="1.0" encoding="utf-8" ?>
<local:TimedLazyContentView
    x:Class="ArriLight.LazyScheduleControlView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArriLight">
    <Border
        x:Name="ScheduleSettingsCardElement"
        Style="{StaticResource MenuCardStyle}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScheduleTapped" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
            <Border Style="{StaticResource MenuIconContainerStyle}">
                <Image Margin="12" Source="control_schedule.svg" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <Label Style="{StaticResource MenuTitleStyle}" Text="定时设置" />
                <Label Style="{StaticResource MenuDescriptionStyle}" Text="管理自动开关灯计划" />
            </VerticalStackLayout>
            <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
        </Grid>
    </Border>
</local:TimedLazyContentView>
