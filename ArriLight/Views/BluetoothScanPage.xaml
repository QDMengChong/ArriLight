<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.BluetoothScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArriLight.ViewModels"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    xmlns:local="clr-namespace:ArriLight"
    x:DataType="vm:BluetoothScanPageViewModel"
    Title="{x:Static strings:AppResources.Device_Add}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid Padding="20,18" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border
            Padding="18"
            BackgroundColor="{StaticResource Primary}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="19"
                        Text="{x:Static strings:AppResources.Scan_Title}"
                        TextColor="White" />
                    <Label
                        FontSize="12"
                        Opacity="0.78"
                        Text="{Binding ScanStatusText}"
                        TextColor="White" />
                </VerticalStackLayout>
                <ActivityIndicator
                    Grid.Column="1"
                    Color="White"
                    IsRunning="{Binding IsScanning}"
                    IsVisible="{Binding IsScanning}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Label
                FontSize="13"
                Text="{x:Static strings:AppResources.Scan_NamingHint}"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                VerticalTextAlignment="Center" />
            <Button
                Grid.Column="1"
                Padding="16,8"
                Command="{Binding StartScanCommand}"
                FontSize="13"
                Text="{x:Static strings:AppResources.Scan_SearchAgain}" />
        </Grid>

        <CollectionView
            x:Name="DeviceCollection"
            Grid.Row="2"
            ItemsSource="{Binding Devices}"
            SelectionChanged="OnDeviceSelected"
            SelectionMode="Single"
            VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="24,70"
                    HorizontalOptions="Center"
                    Spacing="10">
                    <Label
                        FontSize="36"
                        HorizontalTextAlignment="Center"
                        Text="⌁"
                        TextColor="{StaticResource Primary}" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        Text="{Binding EmptyText, Source={RelativeSource AncestorType={x:Type vm:BluetoothScanPageViewModel}}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:DiscoveredBluetoothDevice">
                    <Border
                        Margin="0,0,0,10"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkCardBackground}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1">
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="13">
                            <Border
                                HeightRequest="52"
                                WidthRequest="52"
                                BackgroundColor="{AppThemeBinding Light={StaticResource DeviceIconBackground}, Dark={StaticResource DarkIconBackground}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                                <Image Margin="13" Source="{Binding IconSource}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="16"
                                        Text="{Binding Name}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                    <Border
                                        Padding="6,2"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        VerticalOptions="Center">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="10"
                                            Text="{Binding ProtocolLabel}"
                                            TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Address}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontSize="12"
                                Text="{Binding Rssi, StringFormat='{0} dBm'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid
            x:Name="BindingPromptOverlay"
            Grid.RowSpan="3"
            BackgroundColor="#88000000"
            IsVisible="False"
            Padding="28"
            ZIndex="10">
            <Border
                Padding="22"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkCardBackground}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static strings:AppResources.Pairing_InProgress}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                    <Label
                        x:Name="BindingPromptStatus"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Label
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{x:Static strings:AppResources.Pairing_Instructions}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Label
                        x:Name="BindingPromptCountdown"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource Primary}" />
                    <Button
                        Command="{Binding CancelBindingCommand}"
                        Text="{x:Static strings:AppResources.Pairing_CancelAdding}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
