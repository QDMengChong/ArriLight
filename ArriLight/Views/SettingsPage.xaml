<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.SettingsPage"
    x:DataType="vm:SettingsPageViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArriLight.ViewModels"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    Title="{x:Static strings:AppResources.Settings_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
    <VerticalStackLayout Padding="20,24" Spacing="12">
        <Label
            Margin="4,0,0,4"
            FontSize="13"
            Text="{x:Static strings:AppResources.Settings_Appearance}"
            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />

        <Border Style="{StaticResource MenuCardStyle}">
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Padding="0,2,0,12">
                    <VerticalStackLayout Spacing="3">
                        <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Common_FollowSystem}" />
                        <Label Style="{StaticResource MenuDescriptionStyle}" Text="{x:Static strings:AppResources.Settings_SystemThemeDescription}" />
                    </VerticalStackLayout>
                    <RadioButton
                        x:Name="SystemThemeRadio"
                        Grid.Column="1"
                        GroupName="AppTheme"
                        CheckedChanged="OnSystemThemeChecked"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                    <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Settings_LightTheme}" VerticalTextAlignment="Center" />
                    <RadioButton
                        x:Name="LightThemeRadio"
                        Grid.Column="1"
                        GroupName="AppTheme"
                        CheckedChanged="OnLightThemeChecked"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                <Grid ColumnDefinitions="*,Auto" Padding="0,12,0,2">
                    <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Settings_DarkTheme}" VerticalTextAlignment="Center" />
                    <RadioButton
                        x:Name="DarkThemeRadio"
                        Grid.Column="1"
                        GroupName="AppTheme"
                        CheckedChanged="OnDarkThemeChecked"
                        VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Label
            Margin="4,8,0,0"
            FontSize="12"
            Text="{x:Static strings:AppResources.Settings_ThemePersistenceHint}"
            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />

        <Label
            Margin="4,12,0,4"
            FontSize="13"
            Text="{x:Static strings:AppResources.Settings_Language}"
            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />

        <Border Style="{StaticResource MenuCardStyle}">
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Padding="0,2,0,12">
                    <VerticalStackLayout Spacing="3">
                        <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Common_FollowSystem}" />
                        <Label Style="{StaticResource MenuDescriptionStyle}" Text="{x:Static strings:AppResources.Settings_SystemLanguageDescription}" />
                    </VerticalStackLayout>
                    <RadioButton
                        x:Name="SystemLanguageRadio"
                        Grid.Column="1"
                        GroupName="AppLanguage"
                        Value="system"
                        CheckedChanged="OnLanguageChecked"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                    <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Settings_ChineseLanguage}" VerticalTextAlignment="Center" />
                    <RadioButton
                        x:Name="ChineseLanguageRadio"
                        Grid.Column="1"
                        GroupName="AppLanguage"
                        Value="zh-Hans"
                        CheckedChanged="OnLanguageChecked"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                <Grid ColumnDefinitions="*,Auto" Padding="0,12,0,2">
                    <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Settings_EnglishLanguage}" VerticalTextAlignment="Center" />
                    <RadioButton
                        x:Name="EnglishLanguageRadio"
                        Grid.Column="1"
                        GroupName="AppLanguage"
                        Value="en"
                        CheckedChanged="OnLanguageChecked"
                        VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Label
            Margin="4,8,0,0"
            FontSize="12"
            Text="{x:Static strings:AppResources.Settings_LanguagePersistenceHint}"
            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
        <Label
            x:Name="LanguageRestartNotice" IsVisible="{Binding RequiresRestart}"
            Margin="4,0"
            FontSize="12"
            Text="{x:Static strings:AppResources.Settings_LanguageRestartRequired}"
            TextColor="{StaticResource Primary}" />

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
