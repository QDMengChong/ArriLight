<?xml version="1.0" encoding="utf-8" ?>
<local:TimedLazyContentView
    x:Class="ArriLight.LazyTemperatureLegendView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArriLight">
    <Grid ColumnDefinitions="Auto,*,Auto">
        <Label FontSize="11" Text="暖光" TextColor="#E19A56" />
        <Label
            Grid.Column="1"
            FontSize="11"
            HorizontalTextAlignment="Center"
            Text="色温"
            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
        <Label Grid.Column="2" FontSize="11" Text="冷光" TextColor="#77AEEA" />
    </Grid>
</local:TimedLazyContentView>
