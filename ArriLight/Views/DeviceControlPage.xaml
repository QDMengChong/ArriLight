<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.DeviceControlPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArriLight.ViewModels"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    xmlns:local="clr-namespace:ArriLight"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="vm:DeviceControlPageViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Ellipse
                HeightRequest="10"
                WidthRequest="10"
                Fill="{Binding ConnectionStatusColor, Converter={StaticResource PresentationColorConverter}}"
                VerticalOptions="Center" />
            <Label
                FontFamily="OpenSansSemibold"
                FontSize="17"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                Text="{Binding DeviceName}"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                VerticalTextAlignment="Center" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding RefreshCommand}"
            IconImageSource="action_refresh.svg"
            IsEnabled="{Binding CanRefreshStatus}"
            Order="Primary"
            Priority="0"
            Text="{x:Static strings:AppResources.Common_Refresh}" />
        <ToolbarItem
            Command="{Binding MoreCommand}"
            IconImageSource="profile_settings.svg"
            Order="Primary"
            Priority="1"
            Text="{x:Static strings:AppResources.Common_More}" />
    </ContentPage.ToolbarItems>

    <Grid x:Name="ControlPageContent" RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                Padding="20,20,20,24"
                Spacing="18"
                IsEnabled="{Binding IsDeviceOnline}"
                Opacity="{Binding ControlOpacity}">
                <Border x:Name="LightControlCard" Style="{StaticResource MenuCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="18"
                                    Text="{x:Static strings:AppResources.Control_Title}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                <Label
                                    x:Name="LightControlDescription"
                                    FontSize="12"
                                    Text="{x:Static strings:AppResources.Control_BrightnessDescription}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            </VerticalStackLayout>
                            <toolkit:LazyView
                                x:Name="SavePresetLazyView"
                                Grid.Column="1"
                                IsVisible="False"
                                x:TypeArguments="local:LazySavePresetButtonView" />
                        </Grid>

                        <toolkit:LazyView
                            x:Name="ColorControlLazyView"
                            IsVisible="False"
                            x:TypeArguments="local:LazyColorControlView" />

                        <toolkit:LazyView
                            x:Name="TemperatureLegendLazyView"
                            IsVisible="False"
                            x:TypeArguments="local:LazyTemperatureLegendView" />

                        <BoxView
                            x:Name="ColorBrightnessSeparator"
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />

                        <toolkit:LazyView
                            x:Name="BrightnessControlLazyView"
                            IsVisible="False"
                            x:TypeArguments="local:LazyBrightnessControlView" />
                        <BoxView
                            x:Name="BrightnessEffectSeparator"
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />

                        <toolkit:LazyView
                            x:Name="EffectControlLazyView"
                            IsVisible="False"
                            x:TypeArguments="local:LazyEffectControlView" />
                    </VerticalStackLayout>
                </Border>

                <toolkit:LazyView
                    x:Name="PresetControlLazyView"
                    IsVisible="False"
                    x:TypeArguments="local:LazyPresetControlView" />

                <toolkit:LazyView
                    x:Name="TurnOnDelayControlLazyView"
                    IsVisible="False"
                    x:TypeArguments="local:LazyTurnOnDelayControlView" />

                <toolkit:LazyView
                    x:Name="TimerControlLazyView"
                    IsVisible="False"
                    x:TypeArguments="local:LazyTimerControlView" />

                <toolkit:LazyView
                    x:Name="ScheduleControlLazyView"
                    IsVisible="False"
                    x:TypeArguments="local:LazyScheduleControlView" />
            </VerticalStackLayout>
        </ScrollView>

        <Border
            Grid.Row="1"
            IsVisible="{Binding SupportsPower}"
            IsEnabled="{Binding CanTogglePower}"
            Padding="20,12"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkCardBackground}}"
            Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}"
            StrokeThickness="1">
            <Border
                x:Name="MasterPowerPill"
                HeightRequest="52"
                HorizontalOptions="Fill"
                MaximumWidthRequest="320"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 26">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMasterPowerTapped" />
                </Border.GestureRecognizers>
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,0">
                        <GradientStop Offset="0" Color="#35C9EE" />
                        <GradientStop Offset="1" Color="#3945FF" />
                    </LinearGradientBrush>
                </Border.Background>
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Image
                        x:Name="MasterPowerIcon"
                        HeightRequest="23"
                        Source="power_white.svg"
                        WidthRequest="23" />
                    <Label
                        x:Name="MasterPowerLabel"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        Text="{x:Static strings:AppResources.Common_TurnOff}"
                        TextColor="White"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>
        </Border>
        <toolkit:LazyView
            x:Name="EffectSettingsLazyView"
            Grid.RowSpan="2"
            IsVisible="False"
            x:TypeArguments="local:LazyEffectSettingsOverlayView"
            ZIndex="10">
        </toolkit:LazyView>
    </Grid>
</ContentPage>
