<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.ProfilePage"
    x:DataType="vm:ProfilePageViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArriLight.ViewModels"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border
                Padding="24,34,24,30"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,30,30">
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Offset="0" Color="{StaticResource Primary}" />
                        <GradientStop Offset="1" Color="{StaticResource PrimaryLight}" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="5">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="28"
                        Text="{x:Static strings:AppResources.Tab_Profile}"
                        TextColor="White" />
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="{x:Static strings:AppResources.Profile_Description}"
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Padding="20,24" Spacing="12">
                <Border Style="{StaticResource MenuCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MessageCenterCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                        <Border Style="{StaticResource MenuIconContainerStyle}">
                            <Image Margin="12" Source="profile_messages.svg" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Messages_Title}" />
                            <Label Style="{StaticResource MenuDescriptionStyle}" Text="{x:Static strings:AppResources.Messages_MenuDescription}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource MenuCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SettingsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                        <Border Style="{StaticResource MenuIconContainerStyle}">
                            <Image Margin="12" Source="profile_settings.svg" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Settings_Title}" />
                            <Label Style="{StaticResource MenuDescriptionStyle}" Text="{x:Static strings:AppResources.Settings_MenuDescription}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource MenuCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AppVersionCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                        <Border Style="{StaticResource MenuIconContainerStyle}">
                            <Image Margin="12" Source="profile_version.svg" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Version_Title}" />
                            <Label Style="{StaticResource MenuDescriptionStyle}" Text="{x:Static strings:AppResources.Version_MenuDescription}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource MenuCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AboutUsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                        <Border Style="{StaticResource MenuIconContainerStyle}">
                            <Image Margin="12" Source="profile_about.svg" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.About_Title}" />
                            <Label Style="{StaticResource MenuDescriptionStyle}" Text="{x:Static strings:AppResources.About_MenuDescription}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
