<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.QrCodeScanPage"
    x:DataType="vm:QrCodeScanPageViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArriLight.ViewModels"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    Title="{x:Static strings:AppResources.Qr_Title}"
    BackgroundColor="Black">

    <Grid>
        <zxing:CameraBarcodeReaderView
            x:Name="BarcodeReader"
            BarcodesDetected="OnBarcodesDetected"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <BoxView BackgroundColor="#52000000" />

        <Grid
            Margin="38"
            RowDefinitions="*,240,*">
            <Border
                Grid.Row="1"
                BackgroundColor="Transparent"
                Stroke="White"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="3" />
        </Grid>

        <VerticalStackLayout
            Margin="26,36"
            Spacing="8"
            VerticalOptions="End">
            <Label
                FontFamily="OpenSansSemibold"
                FontSize="18"
                HorizontalTextAlignment="Center"
                Text="{x:Static strings:AppResources.Qr_FrameHint}"
                TextColor="White" />
            <Label
                FontSize="13"
                HorizontalTextAlignment="Center"
                Text="{x:Static strings:AppResources.Qr_PhotosHint}"
                TextColor="#CFFFFFFF" />
            <Grid
                Margin="18,10,18,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    Clicked="OnSelectPhotoClicked"
                    Text="{x:Static strings:AppResources.Qr_SelectPhotos}" />
                <Button
                    x:Name="TorchButton"
                    Grid.Column="1"
                    Clicked="OnTorchClicked"
                    Text="{x:Static strings:AppResources.Qr_TorchOn}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
