<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.OpenSourceLicensesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArriLight"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    x:DataType="local:OpenSourceLicensesPage"
    Title="{x:Static strings:AppResources.Licenses_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">
    <Grid Padding="20,24" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Label FontSize="13" LineHeight="1.4"
               Text="{x:Static strings:AppResources.Licenses_Introduction}"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
        <SearchBar x:Name="LicenseSearch" Grid.Row="1"
                   Placeholder="{x:Static strings:AppResources.Licenses_Search}"
                   TextChanged="OnSearchTextChanged" />
        <CollectionView x:Name="LicenseCollection" Grid.Row="2"
                        ItemsSource="{Binding Components}" SelectionMode="Single"
                        SelectionChanged="OnComponentSelected">
            <CollectionView.EmptyView>
                <Label Margin="0,24" FontSize="14" HorizontalTextAlignment="Center"
                       Text="{x:Static strings:AppResources.Licenses_NoMatches}"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:OpenSourceComponent">
                    <Border Margin="0,0,0,10" Style="{StaticResource MenuCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="5">
                                <Label Style="{StaticResource MenuTitleStyle}" Text="{Binding Name}" LineBreakMode="WordWrap" />
                                <Label Style="{StaticResource MenuDescriptionStyle}" Text="{Binding VersionAndLicense}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Image Grid.Column="1" Style="{StaticResource MenuChevronStyle}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator x:Name="LoadingIndicator" Grid.Row="2" IsVisible="False" Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
