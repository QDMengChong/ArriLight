<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.AppVersionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    xmlns:local="clr-namespace:ArriLight"
    x:DataType="local:AppVersionPage"
    Title="{x:Static strings:AppResources.Version_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,26" Spacing="18">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                <Border
                    HeightRequest="78"
                    WidthRequest="78"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24">
                    <Image Margin="20" Source="device_light_white.svg" />
                </Border>
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    Text="ArriLight"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Label
                    FontSize="13"
                    Text="{Binding VersionText}"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVersionTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <Border Style="{StaticResource MenuCardStyle}">
                <VerticalStackLayout Spacing="13">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="18"
                        Text="{x:Static strings:AppResources.Version_WhatsNew}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource DarkCardStroke}}" />
                    <Label Style="{StaticResource ReleaseNoteStyle}" Text="{x:Static strings:AppResources.Version_DevicesUpdate}" />
                    <Label Style="{StaticResource ReleaseNoteStyle}" Text="{x:Static strings:AppResources.Version_InformationUpdate}" />
                    <Label Style="{StaticResource ReleaseNoteStyle}" Text="{x:Static strings:AppResources.Version_ThemeUpdate}" />
                    <Label Style="{StaticResource ReleaseNoteStyle}" Text="{x:Static strings:AppResources.Version_AndroidUpdate}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
