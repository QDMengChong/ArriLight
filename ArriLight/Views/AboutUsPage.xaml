<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.AboutUsPage"
    x:DataType="vm:AboutUsPageViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArriLight.ViewModels"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    Title="{x:Static strings:AppResources.About_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
    <VerticalStackLayout Padding="20,24" Spacing="12">
        <Border Style="{StaticResource MenuCardStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding UserAgreementCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                <Border Style="{StaticResource MenuIconContainerStyle}">
                    <Image Margin="12" Source="about_agreement.svg" />
                </Border>
                <Label Grid.Column="1" Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Legal_AgreementTitle}" VerticalTextAlignment="Center" />
                <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource MenuCardStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding PrivacyPolicyCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                <Border Style="{StaticResource MenuIconContainerStyle}">
                    <Image Margin="12" Source="about_privacy.svg" />
                </Border>
                <Label Grid.Column="1" Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.Legal_PrivacyTitle}" VerticalTextAlignment="Center" />
                <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource MenuCardStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding WeChatCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                <Border Style="{StaticResource MenuIconContainerStyle}">
                    <Image Margin="11" Source="about_wechat.svg" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.About_WeChatAccount}" />
                    <Label Style="{StaticResource MenuDescriptionStyle}" Text="{x:Static strings:AppResources.About_WeChatInstructions}" />
                </VerticalStackLayout>
                <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource MenuCardStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ContactUsCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                <Border Style="{StaticResource MenuIconContainerStyle}">
                    <Image Margin="12" Source="about_phone.svg" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Style="{StaticResource MenuTitleStyle}" Text="{x:Static strings:AppResources.About_Contact}" />
                    <Label Style="{StaticResource MenuDescriptionStyle}" Text="{x:Static strings:AppResources.About_PhoneExample}" />
                </VerticalStackLayout>
                <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource MenuCardStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenSourceLicensesCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                <Border Style="{StaticResource MenuIconContainerStyle}">
                    <Image Margin="12" Source="about_agreement.svg" />
                </Border>
                <Label Grid.Column="1" Style="{StaticResource MenuTitleStyle}"
                       Text="{x:Static strings:AppResources.Licenses_Title}" VerticalTextAlignment="Center" />
                <Image Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
            </Grid>
        </Border>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
