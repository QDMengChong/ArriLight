<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ArriLight.StorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:ArriLight.Resources.Localization"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid Padding="24">
        <VerticalStackLayout
            HorizontalOptions="Center"
            Spacing="12"
            VerticalOptions="Center">
            <Image HeightRequest="64" Source="tab_store.svg" WidthRequest="64" />
            <Label
                FontFamily="OpenSansSemibold"
                FontSize="22"
                HorizontalTextAlignment="Center"
                Text="{x:Static strings:AppResources.Tab_Store}"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
            <Label
                FontSize="14"
                HorizontalTextAlignment="Center"
                Text="{x:Static strings:AppResources.Store_Placeholder}"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
